# Переменные проекта Vercel "api" (Root Directory = backend). ТОЛЬКО заглушки: настоящие
# значения вводятся в Vercel (Settings -> Environment Variables), в git их нет.
# Подробности: docs/ops/VERCEL.md. Помечено [секрет] - значение не публиковать.

DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=false
# [секрет] python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE-ME-dummy-secret-key-64-random-characters
# Режим serverless: CONN_MAX_AGE=0, запрет пулера БД, только JSON
DJANGO_SERVERLESS=true
# Хост проекта api (его видит Django за внешним rewrite) и хост проекта web
DJANGO_ALLOWED_HOSTS=logistix-api.vercel.app,logistix-web.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://logistix-web.vercel.app
CORS_ALLOWED_ORIGINS=https://logistix-web.vercel.app
DJANGO_BEHIND_TLS_PROXY=true
# IP, который видит API - инфраструктура Vercel, а не пользователь: заголовкам не доверяем
TRUST_PROXY_HEADERS=false
DJANGO_ADMIN_ENABLED=false

# [секрет] ПРЯМАЯ строка Neon (хост БЕЗ "-pooler"), роль приложения logistix_app (NOBYPASSRLS)
DATABASE_URL=postgresql://logistix_app:CHANGE-ME@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL_REQUIRE=true
DATABASE_CONN_MAX_AGE=0

# Лимит попыток входа на один логин
THROTTLE_LOGIN=10/minute
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Не задавать: REDIS_URL (счётчики throttle на экземпляр функции), SENTRY_DSN (пусто = выключен)
SENTRY_DSN=
