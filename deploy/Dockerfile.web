# Образ nginx со статикой SPA и конфигом (reverse proxy на backend). Контекст - КОРЕНЬ репозитория:
#   docker build -f deploy/Dockerfile.web -t logistix-web .
# Сборка и запуск в этом окружении не выполнялись (нет Docker и nginx).

FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY deploy/nginx-proxy-backend.conf /etc/nginx/snippets/proxy-backend.conf
COPY --from=build /web/dist /usr/share/nginx/html
# Каталоги: /srv/static и /srv/media - тома (read-only), /var/www/certbot - ACME webroot
RUN mkdir -p /srv/static /srv/media /var/www/certbot
EXPOSE 80 443
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/nginx-health || exit 1
