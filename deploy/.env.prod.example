# Шаблон окружения продакшена. Копия лежит на сервере как deploy/.env.prod (в git не
# попадает, права 600). ВСЕ значения ниже - заглушки, настоящих секретов здесь нет.
#
# Формат: KEY=VALUE, без кавычек, пробелов и знака $ в значениях (файл читают и docker
# compose, и shell-скрипты deploy/*.sh). Пароли - hex: openssl rand -hex 24 (иначе
# спецсимволы придётся кодировать в URL подключения).

# --- Образы (GHCR). Тег (IMAGE_TAG) здесь НЕ задаётся: его пишет deploy/release.sh в
# deploy/.image_tag.env, и все вызовы compose (release.sh, dc.sh) читают его оттуда. ---
BACKEND_IMAGE=ghcr.io/CHANGE-ME-OWNER/logistix-backend
WEB_IMAGE=ghcr.io/CHANGE-ME-OWNER/logistix-web

# --- Django ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"; ротация разлогинит всех
DJANGO_SECRET_KEY=dummy-secret-key-for-example-only-replace-with-64-random-characters-0123456789
DJANGO_DEBUG=false
# Явный список хостов. localhost нужен для healthcheck контейнера. Домены компаний
# (этап 5) добавляются сюда же; ведущая точка = все поддомены (.logistix.kz).
DJANGO_ALLOWED_HOSTS=app.example.kz,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.kz
CORS_ALLOWED_ORIGINS=https://app.example.kz
# За нашим nginx с TLS: доверять X-Forwarded-Proto, cookie только по https, редирект на https.
# До выпуска сертификата и проверки TLS - false (check --deploy тогда выдаст предупреждения).
DJANGO_BEHIND_TLS_PROXY=true
# Первый адрес X-Forwarded-For - IP клиента; nginx ПЕРЕЗАПИСЫВАЕТ заголовок ($remote_addr).
# true ТОЛЬКО когда backend не доступен снаружи, минуя nginx (в compose порты не публикуются).
TRUST_PROXY_HEADERS=true
# Админка Django: в продакшене выключена; включать только с ограничением по IP на nginx.
DJANGO_ADMIN_ENABLED=false
# Пулер БД: DATABASE_URL, похожий на транзакционный пулер (Neon -pooler, порты 6543/6432,
# pgbouncer=true), при DEBUG=false отклоняется. RLS держит app.company_id в СЕССИИ PostgreSQL, а
# транзакционный PgBouncer смешивает сессии - утечка данных между компаниями. Включайте true ТОЛЬКО
# если пулер работает в режиме SESSION. Проверка - эвристика, другие пулеры не распознаются.
# DATABASE_POOLER_OK=
# HSTS ВЫКЛЮЧЕН по умолчанию (единый источник - этот файл; nginx HSTS не добавляет).
# Как и когда включать - docs/ops/RUNBOOK.md, раздел «HSTS». includeSubDomains не включайте:
# платформа обслуживает пользовательские домены компаний.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
BRANDING_THROTTLE_RATE=60/min
# Уровень логов Django (stderr контейнера): DEBUG|INFO|WARNING|ERROR
DJANGO_LOG_LEVEL=INFO
# Брокер и бэкенд результатов Celery. Обычно НЕ менять: по умолчанию тот же Redis, что и REDIS_URL
# (compose подставляет redis://:REDIS_PASSWORD@redis:6379/0). Значения здесь переопределяют умолчание.
# CELERY_BROKER_URL=redis://:CHANGE-ME@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:CHANGE-ME@redis:6379/0
# Воркеры gunicorn: 2 * CPU + 1, но с оглядкой на память (лимит контейнера 768M)
GUNICORN_WORKERS=3

# --- PostgreSQL ---
# POSTGRES_USER - владелец БД и таблиц (миграции, бэкапы); приложение ходит ролью logistix_app
POSTGRES_DB=logistix
POSTGRES_USER=logistix
POSTGRES_PASSWORD=dummy-owner-password-replace-me-0123456789abcdef
APP_DB_PASSWORD=dummy-app-password-replace-me-0123456789abcdef

# --- Redis (обязателен: общие счётчики throttle и кэш) ---
REDIS_PASSWORD=dummy-redis-password-replace-me-0123456789abcdef

# --- Sentry: пусто = выключен. DSN только собственного/казахстанского Sentry, иначе данные
# уйдут за рубеж. Тела запросов, cookie, Authorization и PII не отправляются. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# --- nginx / TLS ---
# Каталог сертификатов на хосте; ожидается live/logistix/{fullchain,privkey}.pem
# (certbot --cert-name logistix или сертификат hoster.kz, положенный туда же)
LETSENCRYPT_DIR=/etc/letsencrypt

# --- Бэкапы (deploy/backup.sh; не контейнерные переменные) ---
BACKUP_DIR=/var/backups/logistix
BACKUP_KEEP_DAYS=14
# Шифрование: получатель GPG (публичный ключ в связке пользователя) ИЛИ файл с парольной фразой
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_PASSPHRASE_FILE=
# Выгрузка на отдельное хранилище в Казахстане (rsync по ssh), напр. backup@storage.example.kz:/srv/logistix/
BACKUP_REMOTE=
BACKUP_SSH_KEY=
