DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://logistix:logistix@127.0.0.1:5432/logistix
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Загрузки (логотипы компаний); S3/MinIO - этап 5
# MEDIA_ROOT=/var/lib/logistix/media
# MEDIA_URL=/media/
# BRANDING_THROTTLE_RATE=60/min
# В продакшене REDIS_URL обязателен (общий кэш и throttle между воркерами):
# REDIS_URL=redis://127.0.0.1:6379/0
# Продакшен-переменные: deploy/.env.prod.example и docs/ops/RUNBOOK.md
# DJANGO_ADMIN_ENABLED=true
# SENTRY_DSN=
